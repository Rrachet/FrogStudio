# Frog Studios configuration
# Copy values into your terminal/session environment before running the server.

# Required for saving contact form submissions to Google Sheets.
# Use the Web App deployment URL from Google Apps Script.
GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional email notifications.
# Email sender account (must have Gmail app password enabled)
EMAIL_USER=frogstudiozz@gmail.com

# Email recipient for contact form submissions
# Default: amarnathmishra5200@gmail.com
EMAIL_TO=amarnathmishra5200@gmail.com

# Gmail app password (enable 2-step verification to create one)
# See EMAIL_SETUP.md for detailed instructions
EMAIL_PASSWORD=your_gmail_app_password_here

# Optional server port.
PORT=3000